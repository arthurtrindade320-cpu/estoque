# Neon (https://console.neon.tech) -> seu projeto -> botão "Connect"
#
# DATABASE_URL: conexão COM pooler (host contém "-pooler"). Usada pelo app.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# DIRECT_URL: conexão DIRETA (mesmo host, mas SEM "-pooler"). Usada pelas migrations.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
